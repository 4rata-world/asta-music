# ジャンルタグ（MusicBrainz のタグ名に合わせる・カンマ区切り）
# タグ一覧: https://musicbrainz.org/tags
# 例:
# GENRES=j-pop,city pop,vocaloid
GENRES=j-pop,vocaloid,rock


# =============================
# ポーリング設定
# =============================

# チェック間隔（分）。30〜60分推奨（MusicBrainz の更新頻度に合わせる）
POLL_INTERVAL_MINUTES=60
